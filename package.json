{
  "name": "pairwire-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/core",
    "packages/relay-node",
    "packages/relay-worker",
    "packages/client"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:plugin": "tsx scripts/build-plugin.ts",
    "test": "vitest run --project=!e2e",
    "test:e2e": "vitest run --project e2e",
    "test:live": "vitest run --project relay-node --testTimeout=30000 test/live.test.ts",
    "lint": "eslint . && tsx scripts/check-hidden-chars.ts && tsx scripts/check-inbound-imports.ts && npm run typecheck --workspaces && tsc -p scripts/tsconfig.json && tsc -p tests/tsconfig.json",
    "traceability": "tsx scripts/check-traceability.ts",
    "relay:dev": "npm run build && npm run dev -w @pairwire/relay-worker",
    "relay:node": "tsx packages/relay-node/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
